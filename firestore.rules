rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Bir flock belgesinin verisini getirir (bildirim dogrulamasi icin).
    function flockData(flockId) {
      return get(/databases/$(database)/documents/flocks/$(flockId)).data;
    }

    // Kullanıcı profilleri — herkes okuyabilir (keşif için),
    // ama sadece sahibi kendi belgesini yazabilir.
    // 'verified' statüsünü istemci KENDİNE veremez — yalnızca admin
    // (konsol/Admin SDK, kurallara tabi değil) inceleme sonrası işler.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.verificationStatus != 'verified';
      allow update: if request.auth != null && request.auth.uid == userId
                    && (request.resource.data.verificationStatus != 'verified'
                        || resource.data.verificationStatus == 'verified');
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Kilitli özel veriler (doğrulama selfie'si vb.) — yalnızca sahibi
      // yazar/okur; diğer kullanıcılara tamamen kapalı. İnceleme konsoldan.
      match /private/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Bildirimler — yalnizca, KATILDIGIN bir flock'un HOST'una, kendi adina
      // ('actorUid == kendisi') bir 'join' bildirimi olusturabilirsin.
      // Boylece rastgele bir kullaniciya sahte/gonderen-taklidi bildirim
      // enjekte edilmesi engellenir. Okuma/isaretleme/silme yalnizca sahibine.
      match /notifications/{notifId} {
        allow create: if request.auth != null
                      && request.resource.data.actorUid == request.auth.uid
                      && request.resource.data.type == 'join'
                      && userId == flockData(request.resource.data.flockId).hostUid
                      && request.auth.uid in flockData(request.resource.data.flockId).memberUids;
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Flock'lar — giriş yapan herkes görebilir (keşif).
    // Oluşturan kişi host olmalı. Silme yalnızca host'a açık.
    match /flocks/{flockId} {
      allow read: if request.auth != null;
      // Yeni flock sıkı doğrulanır: oluşturan TEK üye olabilir (başka uid
      // enjekte edilemez), süre gelecekte + makul üst sınırlı (doğduğu anda
      // dolmuş olamaz → puan sabotajı kapanır), kapasite makul, ve
      // "doğrulanmış host" rozeti ancak profil gerçekten verified ise true.
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.memberNames is map
        && request.resource.data.memberNames.keys().hasOnly([request.auth.uid])
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(3, 'h')
        && request.resource.data.total is int
        && request.resource.data.total >= 2
        && request.resource.data.total <= 12
        && (request.resource.data.verifiedHost == false
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == 'verified');

      // Güncelleme YALNIZCA çağıranın KENDİ üyeliğini değiştirebilir:
      // kendi uid'ini ekler (join) ya da çıkarır (leave). Başkasının üyeliğine
      // ya da isim girdisine dokunamaz; host/mekan/süre/konum/total değişemez;
      // kapasite aşılamaz.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberUids', 'memberNames'])
        // memberNames iki tarafta da map olmalı (eski List-şekilli belge
        // diff'te hata fırlatıp yazımı bozmasın), ve yalnızca çağıranın
        // kendi girdisi değişebilir.
        && request.resource.data.memberNames is map
        && resource.data.memberNames is map
        && request.resource.data.memberNames.diff(resource.data.memberNames)
             .affectedKeys().hasOnly([request.auth.uid])
        && (
          // JOIN — memberUids'e SADECE kendi uid'ini ekler, kapasiteyi aşmaz.
          (
            request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
            && request.resource.data.memberUids.hasAll(resource.data.memberUids)
            && request.resource.data.memberUids
                 .hasOnly(resource.data.memberUids.concat([request.auth.uid]))
            && request.resource.data.memberUids.size() <= resource.data.total
          )
          ||
          // LEAVE — memberUids'ten SADECE kendi uid'ini çıkarır.
          (
            request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
            && resource.data.memberUids.hasAll(request.resource.data.memberUids)
            && resource.data.memberUids
                 .hasOnly(request.resource.data.memberUids.concat([request.auth.uid]))
          )
        );

      allow delete: if request.auth != null
                    && resource.data.hostUid == request.auth.uid;
    }

    // Buluşma sonrası üye puanları. Belge kimliği deterministik
    // (flockId_rater_rated) → aynı kişiye ikinci puan create'e takılır
    // (update yasak). Yalnızca süresi dolmuş bir flock'un iki GERÇEK üyesi
    // arasında, kendi adına, 1-5 tam sayı.
    match /ratings/{ratingId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.ratedUid
                      || request.auth.uid == resource.data.raterUid);
      allow create: if request.auth != null
        && request.resource.data.raterUid == request.auth.uid
        && request.resource.data.ratedUid != request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && ratingId == request.resource.data.flockId + '_'
             + request.auth.uid + '_' + request.resource.data.ratedUid
        && request.auth.uid in flockData(request.resource.data.flockId).memberUids
        && request.resource.data.ratedUid in flockData(request.resource.data.flockId).memberUids
        && flockData(request.resource.data.flockId).expiresAt < request.time;
      allow update, delete: if false;
    }

    // Şikayetler — kullanıcı yalnızca KENDİ adına şikayet oluşturabilir;
    // kimse (şikayet eden dahil) istemciden okuyamaz. İnceleme admin
    // tarafında (konsol/araç, kurallara tabi değil).
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid != request.auth.uid
        && request.resource.data.reason in
             ['harassment', 'fake', 'no_show', 'safety', 'other'];
      allow read, update, delete: if false;
    }

    // Flock+ abonelik yetkisi (entitlement). İSTEMCİ ASLA YAZAMAZ — sahte
    // premium imkansiz olsun diye. Yalnizca sunucu (VM/servis hesabi, kurallara
    // tabi degil) Play purchaseToken dogrulandiktan sonra yazar.
    // Alanlar: status ("trial"|"active"|"expired"|"canceled"), productId,
    // trialEndsAt, currentPeriodEnd, updatedAt.
    match /subscriptions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Diğer her şey varsayılan olarak kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
