rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Bir flock belgesinin verisini getirir (bildirim dogrulamasi icin).
    function flockData(flockId) {
      return get(/databases/$(database)/documents/flocks/$(flockId)).data;
    }

    // Kullanıcı profilleri — herkes okuyabilir (keşif için),
    // ama sadece sahibi kendi belgesini yazabilir.
    // 'verified' statüsünü istemci KENDİNE veremez — yalnızca admin
    // (konsol/Admin SDK, kurallara tabi değil) inceleme sonrası işler.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.verificationStatus != 'verified';
      allow update: if request.auth != null && request.auth.uid == userId
                    && (request.resource.data.verificationStatus != 'verified'
                        || resource.data.verificationStatus == 'verified');
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Herkese açık ama AYRI tutulan ağır veri (profil fotoğrafı).
      // Ana belgeden ayrıldı: deste sorgusu 40 kişi çekerken 22 KB'lik
      // base64'ü de indirmesin diye. Okuma girişe açık, yazma yalnız sahibine.
      match /public/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Kilitli özel veriler (doğrulama selfie'si vb.) — yalnızca sahibi
      // yazar/okur; diğer kullanıcılara tamamen kapalı. İnceleme konsoldan.
      match /private/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Bildirimler — yalnizca, KATILDIGIN bir flock'un HOST'una, kendi adina
      // ('actorUid == kendisi') bir 'join' bildirimi olusturabilirsin.
      // Boylece rastgele bir kullaniciya sahte/gonderen-taklidi bildirim
      // enjekte edilmesi engellenir. Okuma/isaretleme/silme yalnizca sahibine.
      match /notifications/{notifId} {
        allow create: if request.auth != null
                      && request.resource.data.actorUid == request.auth.uid
                      && request.resource.data.type == 'join'
                      && userId == flockData(request.resource.data.flockId).hostUid
                      && request.auth.uid in flockData(request.resource.data.flockId).memberUids;
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Flock'lar — giriş yapan herkes görebilir (keşif).
    // Oluşturan kişi host olmalı. Silme yalnızca host'a açık.
    match /flocks/{flockId} {
      allow read: if request.auth != null;
      // Yeni flock sıkı doğrulanır: oluşturan TEK üye olabilir (başka uid
      // enjekte edilemez), süre gelecekte + makul üst sınırlı (doğduğu anda
      // dolmuş olamaz → puan sabotajı kapanır), kapasite makul, ve
      // "doğrulanmış host" rozeti ancak profil gerçekten verified ise true.
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.memberNames is map
        && request.resource.data.memberNames.keys().hasOnly([request.auth.uid])
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(3, 'h')
        && request.resource.data.total is int
        && request.resource.data.total >= 2
        && request.resource.data.total <= 12
        && (request.resource.data.verifiedHost == false
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verificationStatus == 'verified');

      // Güncelleme YALNIZCA çağıranın KENDİ üyeliğini değiştirebilir:
      // kendi uid'ini ekler (join) ya da çıkarır (leave). Başkasının üyeliğine
      // ya da isim girdisine dokunamaz; host/mekan/süre/konum/total değişemez;
      // kapasite aşılamaz.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['memberUids', 'memberNames'])
        // memberNames iki tarafta da map olmalı (eski List-şekilli belge
        // diff'te hata fırlatıp yazımı bozmasın), ve yalnızca çağıranın
        // kendi girdisi değişebilir.
        && request.resource.data.memberNames is map
        && resource.data.memberNames is map
        && request.resource.data.memberNames.diff(resource.data.memberNames)
             .affectedKeys().hasOnly([request.auth.uid])
        && (
          // JOIN — memberUids'e SADECE kendi uid'ini ekler, kapasiteyi aşmaz.
          (
            request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
            && request.resource.data.memberUids.hasAll(resource.data.memberUids)
            && request.resource.data.memberUids
                 .hasOnly(resource.data.memberUids.concat([request.auth.uid]))
            && request.resource.data.memberUids.size() <= resource.data.total
          )
          ||
          // LEAVE — memberUids'ten SADECE kendi uid'ini çıkarır.
          (
            request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
            && resource.data.memberUids.hasAll(request.resource.data.memberUids)
            && resource.data.memberUids
                 .hasOnly(request.resource.data.memberUids.concat([request.auth.uid]))
          )
        );

      allow delete: if request.auth != null
                    && resource.data.hostUid == request.auth.uid;
    }

    // Buluşma sonrası üye puanları. Belge kimliği deterministik
    // (flockId_rater_rated) → aynı kişiye ikinci puan create'e takılır
    // (update yasak). Yalnızca süresi dolmuş bir flock'un iki GERÇEK üyesi
    // arasında, kendi adına, 1-5 tam sayı.
    match /ratings/{ratingId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.ratedUid
                      || request.auth.uid == resource.data.raterUid);
      allow create: if request.auth != null
        && request.resource.data.raterUid == request.auth.uid
        && request.resource.data.ratedUid != request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && ratingId == request.resource.data.flockId + '_'
             + request.auth.uid + '_' + request.resource.data.ratedUid
        && request.auth.uid in flockData(request.resource.data.flockId).memberUids
        && request.resource.data.ratedUid in flockData(request.resource.data.flockId).memberUids
        && flockData(request.resource.data.flockId).expiresAt < request.time;
      allow update, delete: if false;
    }

    // Şikayetler — kullanıcı yalnızca KENDİ adına şikayet oluşturabilir;
    // kimse (şikayet eden dahil) istemciden okuyamaz. İnceleme admin
    // tarafında (konsol/araç, kurallara tabi değil).
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid != request.auth.uid
        && request.resource.data.reason in
             ['harassment', 'fake', 'no_show', 'safety', 'other'];
      allow read, update, delete: if false;
    }

    // Flock+ abonelik yetkisi (entitlement). İSTEMCİ ASLA YAZAMAZ — sahte
    // premium imkansiz olsun diye. Yalnizca sunucu (VM/servis hesabi, kurallara
    // tabi degil) Play purchaseToken dogrulandiktan sonra yazar.
    // Alanlar: status ("trial"|"active"|"expired"|"canceled"), productId,
    // trialEndsAt, currentPeriodEnd, updatedAt.
    match /subscriptions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Date modu beğenileri. Belge kimliği '{from}_{to}' — kimliği veriyle
    // ZORUNLU eşleştiriyoruz ki başkası adına beğeni yazılamasın.
    //
    // Okuma yalnizca iki tarafa acik: kendi begenini gorursun, bir de SANA
    // gelen begeniyi (karsilikliligi boyle saptariz). Ucuncu bir kullanici
    // kimin kimi begendigini goremez.
    //
    // Guncelleme yok: begeni degistirilemez, yalniz sahibi silebilir.
    match /likes/{likeId} {
      allow create: if request.auth != null
                    && request.resource.data.from == request.auth.uid
                    && request.resource.data.to is string
                    && request.resource.data.from != request.resource.data.to
                    && likeId == request.resource.data.from + '_' + request.resource.data.to;
      allow read: if request.auth != null
                  && (resource.data.from == request.auth.uid
                      || resource.data.to == request.auth.uid);
      allow delete: if request.auth != null && resource.data.from == request.auth.uid;
      allow update: if false;
    }

    // Sohbetler. İki tür de aynı belge şeklini kullanır:
    //   'dm'    — birbirini beğenmiş iki kişi. Kimlik: dm_{küçükUid}_{büyükUid}
    //   'flock' — bir flock'un üyeleri.        Kimlik: flock_{flockId}
    //
    // Kimlik VERİDEN TÜRETİLİR ve kural bunu doğrular. Böylece kimse üyesi
    // olmadığı bir sohbeti açamaz, uydurma kimlikle başkasının sohbetine
    // sızamaz. DM'de uid'lerin sıralı olması şart — aynı çift için iki ayrı
    // sohbet doğmasın diye.
    match /threads/{threadId} {

      function thread() {
        return get(/databases/$(database)/documents/threads/$(threadId)).data;
      }

      // DM'de üyelik belgede sabittir. Flock sohbetinde CANLI olarak flock
      // belgesinden okunur: sonradan katılan okuyabilsin, ayrılan okuyamasın.
      //
      // Üçlü operatör yerine kısa devre yapan && / || kullanılıyor: DM
      // belgesinde 'flockId' alanı YOK, flockData(t.flockId) o dalda
      // değerlendirilirse kural hata verip her okumayı reddediyor.
      function isMemberOf(t) {
        return request.auth != null
               && (
                    (t.kind == 'dm' && request.auth.uid in t.memberUids)
                    || (t.kind == 'flock'
                        && request.auth.uid in flockData(t.flockId).memberUids)
                  );
      }

      // Mesajlaşma yalnızca KARŞILIKLI beğeniyle açılır — tek yönlü beğeni
      // kimseye mesaj kutusu açmaz.
      function mutual(a, b) {
        return exists(/databases/$(database)/documents/likes/$(a + '_' + b))
            && exists(/databases/$(database)/documents/likes/$(b + '_' + a));
      }

      function touched(key) {
        return key in request.resource.data.diff(resource.data).affectedKeys();
      }

      // get ve list AYRI: tek bir 'read' kuralında 'resource == null'
      // denetimi liste sorgusunda da değerlendiriliyor ve sorguyu
      // reddediyordu.
      //
      // get'te belge YOKKEN de izin veriyoruz: istemci mesaj göndermeden önce
      // "sohbet açılmış mı" diye bakıyor. Bu denetim olmadan o bakış
      // reddedilir ve ilk mesaj hiç gönderilemez. Var olmayan belgeden veri
      // sızmaz.
      allow get: if request.auth != null
                 && (resource == null || isMemberOf(resource.data));

      // Sohbetlerim listesi. Firestore liste kurallarını belgeleri okuyarak
      // değil SORGUYA bakarak doğrular: kuralda sorgunun kısıtlamadığı bir
      // alan geçerse (burada 'kind') sorgunun tamamı reddedilir. Bu yüzden
      // koşul, sorgunun kısıtıyla birebir aynı: memberUids array-contains ben.
      //
      // Güvenlik açığı yok — 'memberUids' yalnızca DM belgelerinde dolu; flock
      // sohbetinde üyelik flock belgesinden okunduğu için bu alan hiç yazılmaz.
      allow list: if request.auth != null
                  && request.auth.uid in resource.data.memberUids;

      allow create: if request.auth != null
        // Okundu damgası kendi adına başlar; karşı tarafınkini kuramazsın.
        && request.resource.data.seenAt is map
        && request.resource.data.seenAt.keys().hasOnly([request.auth.uid])
        && (
          (
            request.resource.data.kind == 'dm'
            && request.resource.data.memberUids is list
            && request.resource.data.memberUids.size() == 2
            && request.auth.uid in request.resource.data.memberUids
            && request.resource.data.memberUids[0] < request.resource.data.memberUids[1]
            && threadId == 'dm_' + request.resource.data.memberUids[0]
                 + '_' + request.resource.data.memberUids[1]
            && mutual(request.resource.data.memberUids[0],
                      request.resource.data.memberUids[1])
          )
          ||
          (
            request.resource.data.kind == 'flock'
            && request.resource.data.flockId is string
            && threadId == 'flock_' + request.resource.data.flockId
            && request.auth.uid in flockData(request.resource.data.flockId).memberUids
          )
        );

      // Yalnızca "son mesaj" özeti ve okundu damgaları değişir; tür, üyelik ve
      // flock bağı sabit kalır — sohbet sonradan başka bir sohbete dönüşemez.
      allow update: if isMemberOf(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastText', 'lastFrom', 'lastAt', 'seenAt'])
        // Özeti değiştiren, o mesajın göndericisi olmalı.
        && (!touched('lastFrom') || request.resource.data.lastFrom == request.auth.uid)
        // Okundu damgası yalnızca kendine yazılır — başkasının rozetini
        // silemezsin.
        && (!touched('seenAt')
            || request.resource.data.seenAt.diff(resource.data.seenAt)
                 .affectedKeys().hasOnly([request.auth.uid]));

      allow delete: if false;

      match /messages/{msgId} {
        // Sohbet belgesi henüz açılmamışsa (kimse yazmamışsa) mesaj sorgusu
        // BOŞ döner; bunu reddetmek ekranda sahte bir hata çıkarır. Belgesiz
        // bir yola mesaj yazılamadığı için (create thread'in varlığını şart
        // koşuyor) burada okunacak bir şey de yok.
        allow read: if request.auth != null
                    && (!exists(/databases/$(database)/documents/threads/$(threadId))
                        || isMemberOf(thread()));
        allow create: if isMemberOf(thread())
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        // Gönderilmiş mesaj DEĞİŞTİRİLEMEZ: şikayet incelemesi sağlam bir
        // kayda dayansın. Kendi mesajını silebilirsin.
        allow update: if false;
        allow delete: if request.auth != null && resource.data.from == request.auth.uid;
      }
    }

    // Diğer her şey varsayılan olarak kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
